{
  "name": "super-admin",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write app lib models scripts tests docs *.json *.ts *.mjs README.md",
    "test:http": "node --experimental-strip-types scripts/test-http.ts",
    "lint": "eslint .",
    "dev:credentials": "node --experimental-strip-types scripts/dev-credentials.ts",
    "test:integration": "node --experimental-strip-types scripts/test-integration.ts",
    "db:migrate-sqlite": "node --experimental-strip-types scripts/migrate-sqlite.ts"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "lucide-react": "0.474.0",
    "mongoose": "^8.24.8",
    "next-auth": "^4.24.15",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.6.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.29",
    "@eslint/eslintrc": "^3.3.1",
    "mongodb-memory-server": "^10.4.3"
  },
  "type": "module",
  "overrides": {
    "postcss": "^8.5.32"
  }
}
