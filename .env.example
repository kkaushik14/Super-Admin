# Keep private. Node 24+ and a persistent disk are required.
ADMIN_ORIGIN=http://localhost:3100
ADMIN_DATA_DIR=.data
# Read-only interface on loopback during development, never production.
ADMIN_PREVIEW=1
# Explicit project connection hosts, comma separated. No wildcard hosts.
ADMIN_ALLOWED_PROJECT_HOSTS=www.reelogram.in
# Provision one independent secret per project through the deployment environment.
# ADMIN_PROJECT_REELOGRAM_SECRET=
