# Local origin. Replace with the exact HTTPS Vercel/custom origin when deploying.
SUPERADMIN_APP_URL=http://localhost:3100
# Dedicated Atlas database user restricted to this database. Never use ReeloGram credentials.
SUPERADMIN_MONGODB_URL=
SUPERADMIN_MONGODB_DB=superadmin_development
# Independent random secret, at least 32 characters. Never reuse ReeloGram's secret.
SUPERADMIN_AUTH_SECRET=
# Google Web OAuth client. Local redirect URI: http://localhost:3100/api/auth/callback/google
SUPERADMIN_GOOGLE_CLIENT_ID=
SUPERADMIN_GOOGLE_CLIENT_SECRET=
SUPERADMIN_GOOGLE_OWNER_EMAIL=
# Optional immutable Google sub; required for non-Gmail/non-Workspace email identities.
SUPERADMIN_GOOGLE_OWNER_SUBJECT=
# Only works locally in NODE_ENV=development, never Vercel or production.
SUPERADMIN_DEV_LOGIN_ENABLED=0
SUPERADMIN_DEV_EMAIL=
# bcrypt: encoded hash from npm run dev:credentials (avoids dotenv dollar expansion).
SUPERADMIN_DEV_PASSWORD_HASH=
# Project connections are independent of administrator Google sign-in.
SUPERADMIN_ALLOWED_PROJECT_HOSTS=www.reelogram.in
SUPERADMIN_PROJECT_REELOGRAM_KEY_ID=
SUPERADMIN_PROJECT_REELOGRAM_SECRET=
# Optional exact loopback origin; development only, read-only, never Vercel.
SUPERADMIN_LOCAL_PROJECT_ORIGIN=
SUPERADMIN_PROJECT_REELOGRAM_LOCAL_KEY_ID=
SUPERADMIN_PROJECT_REELOGRAM_LOCAL_SECRET=

# Optional moderation, disabled until matching receiver configuration and verification.
SUPERADMIN_PROJECT_REELOGRAM_ACTIONS_ENABLED=0
SUPERADMIN_PROJECT_REELOGRAM_WRITE_KEY_ID=
SUPERADMIN_PROJECT_REELOGRAM_WRITE_SECRET=
# google:<immutable subject pinned by verified Google owner login>
SUPERADMIN_PROJECT_REELOGRAM_OWNER_ID=
SUPERADMIN_PROJECT_REELOGRAM_ACTIONS=accounts.suspend,accounts.restore,videos.hide,videos.restore
